{
    "name": "dock",
    "layer": "top",
    "position": "left",
    "width": 64,
    "margin-top": 55,
    "margin-bottom": 15,
    "margin-left": 10,

    "modules-center": [
        "wlr/taskbar"
    ],
    "modules-bottom": [
        "custom/settings"
    ],

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 26,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "on-click-right": "fullscreen",
        "ignore-list": [],
        "active-first": false
    },

    "custom/settings": {
        "format": " ⚙ ",
        "on-click": "pavucontrol || nm-connection-editor",
        "tooltip": true,
        "tooltip-format": "Control Center / Quick Settings"
    }
}
